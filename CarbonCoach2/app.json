{
  "expo": {
    "name": "CarbonCoach",
    "slug": "carboncoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carboncoach",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F14",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CarbonCoach to access camera to photograph and analyze meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CarbonCoach to access photos to select meal images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
